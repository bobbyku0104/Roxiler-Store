NODE_ENV=development
PORT=5000
# Frontend URL(s) allowed to call the API, comma separated
CORS_ORIGIN=http://localhost:5173

# Either set DATABASE_URL (Render, Railway, Neon...) or the individual DB_* values
# DATABASE_URL=postgres://user:password@host:5432/store_rating
DB_HOST=localhost
DB_PORT=5433
DB_NAME=store_rating
DB_USER=postgres
DB_PASSWORD=postgres
# Set to true when the database requires SSL (e.g. Render's external URL)
DB_SSL=false

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Number of proxies in front of the API (1 on Render), used for rate limiting
TRUST_PROXY=0
# Demo owners/users/stores are always seeded in development; in production only when true
SEED_DEMO_DATA=true

# Name: 20-60 characters. Password: 8-16 characters, 1 uppercase, 1 special character.
ADMIN_NAME=System Administrator Account
ADMIN_EMAIL=admin@storerating.com
ADMIN_PASSWORD=Admin@123
